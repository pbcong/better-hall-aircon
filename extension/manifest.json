{
  "manifest_version": 3,
  "name": "Hall Aircon Login Helper",
  "version": "0.1.0",
  "description": "Transfers the Daikin login return address to your local Hall Aircon demo. Does not read the NTU login page.",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "background.js"},
  "content_scripts": [
    {"matches": ["http://127.0.0.1/*"], "js": ["local.js"]},
    {"matches": ["https://cmsntu-prod.daikinpayu.com/adfs/saml/redirect/*"], "js": ["return.js"], "run_at": "document_start"}
  ]
}
